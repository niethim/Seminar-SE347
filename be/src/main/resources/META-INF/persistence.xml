<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="VoucherPU" transaction-type="JTA">
        <jta-data-source>java:jboss/datasources/VoucherDS</jta-data-source>
        
        <class>com.demo.voucher.model.Voucher</class>
        <class>com.demo.voucher.model.VoucherClaim</class>
        <class>com.demo.voucher.model.AuditLog</class>
        <class>com.demo.voucher.model.BatchClearingRecord</class>

        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="update"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.show_sql" value="false"/>
        </properties>
    </persistence-unit>

</persistence>
